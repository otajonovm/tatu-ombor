{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://web-production-0da87.up.railway.app/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://web-production-0da87.up.railway.app/media/:path*"
    },
    {
      "source": "/health",
      "destination": "https://web-production-0da87.up.railway.app/health"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
